# Firebase Client (for admin login UI)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server-only). Required for admin API (list users, verify tokens).
# Option A: path to service account JSON (download from Firebase Console → Project settings
#           → Service accounts → Generate new private key). Save the file in this app folder
#           and set the path below (e.g. ./serviceAccountKey.json).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option B: inline (e.g. Vercel) - set FIREBASE_ADMIN_PROJECT_ID + FIREBASE_ADMIN_CLIENT_EMAIL + FIREBASE_ADMIN_PRIVATE_KEY
# FIREBASE_ADMIN_PROJECT_ID=

# Comma-separated list of Firebase Auth UIDs that are allowed to access /admin
ADMIN_USER_IDS=

# Staging / preview gate: when set, visitors on non-localhost hosts must enter this code once
# (HTTP-only cookie). Local dev (localhost, 127.0.0.1, ::1) is never gated. Omit in production
# when the site goes live. Enforced in the root layout (Node) so Firebase/runtime env works;
# Next.js middleware alone would not see vars that exist only at runtime on the Edge.
# PREVIEW_ACCESS_CODE=

# RevenueCat + Firestore (subscription/entitlements). Optional; if unset, subscription pill shows "—".
# Path to the Firestore document where the RevenueCat Firebase Extension writes customer data.
# Default: users/{app_user_id}/purchaser-info/{app_user_id}
# REVENUECAT_CUSTOMERS_DOC_PATH=users/{app_user_id}/purchaser-info/{app_user_id}
# Optional: JSON map of entitlement identifier -> display label, e.g. {"pro":"Pro","premium":"Premium"}
# REVENUECAT_ENTITLEMENT_LABELS={"pro":"Pro","premium":"Premium"}
